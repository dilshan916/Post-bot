# RedditDaily-Bot — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp & output
temp/
output/*.mp4
output/logs/

# Data
# data/scraped_history.json (tracked for CI/CD history persistence)

# Assets (large binary files)
assets/gameplay/*
!assets/gameplay/.gitkeep
assets/vosk_model/

# Config (contains API keys)
config.yaml

# OS
Thumbs.db
.DS_Store
