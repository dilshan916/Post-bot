# RedditDaily-Bot — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp & output
temp/
output/*.mp4
output/logs/

# Data
# data/scraped_history.json (tracked for CI/CD history persistence)

# Assets (large binary files)
assets/gameplay/*
!assets/gameplay/.gitkeep
!assets/gameplay/default_gameplay.mp4
assets/vosk_model/

# Config & Credentials (contains API keys)
config.yaml
youtube_credentials.json
client_secret*.json

# OS
Thumbs.db
.DS_Store
